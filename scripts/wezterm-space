#!/bin/sh
set -eu
unset NO_COLOR

source=$0
while [ -L "$source" ]; do
    source_dir=$(CDPATH= cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    case "$source" in
        /*) ;;
        *) source="$source_dir/$source" ;;
    esac
done

script_dir=$(CDPATH= cd -P "$(dirname "$source")" && pwd)
repo_dir=$(CDPATH= cd "$script_dir/.." && pwd)
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file=${WEZTERM_SPACE_CONFIG:-"$config_dir/wezterm/wezterm-space.lua"}

set -- connect --class wezterm-space-dev space "$@"
if [ -f "$config_file" ]; then
    set -- --config-file "$config_file" "$@"
fi

exec "$repo_dir/target/release/wezterm-space" "$@"
